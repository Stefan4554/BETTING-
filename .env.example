# ─────────────────────────────────────────────────────────────────────────────
# BETTING EDGE PRO — environment variables
# Copy to .env.local for local development. In production set them in
# Vercel → Project → Settings → Environment Variables.
# Only NEXT_PUBLIC_* values reach the browser. Everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ── https://supabase.com/dashboard/project/_/settings/api
# Local stack: `npx supabase start` prints these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used for encrypted API-key access, odds ingestion and request logs.
SUPABASE_SERVICE_ROLE_KEY=

# ── Secure API key storage ── 32 random bytes (hex). Generate: openssl rand -hex 32
# Rotating it makes stored provider keys unreadable (users re-enter them).
API_KEY_ENCRYPTION_KEY=

# ── Background jobs ── Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# ── Optional: platform-wide odds feed (shared, read-only market data for all users) ──
# Users normally connect their own keys in Settings → Data sources instead.
THE_ODDS_API_KEY=
PLATFORM_ODDS_SPORTS=          # e.g. soccer_epl,basketball_nba
PLATFORM_ODDS_REGIONS=eu,uk
API_FOOTBALL_KEY=

# ── Email notifications via Resend ── https://resend.com
# API key (server-only, starts with re_). Sender must be on a domain verified in Resend,
# e.g. "Betting Edge Pro <alerts@yourdomain.com>".
RESEND_API_KEY=
ALERTS_FROM_EMAIL=
# Webhook signing secret (whsec_…) from Resend → Webhooks, endpoint https://<domain>/api/webhooks/resend,
# events: email.sent, email.delivered, email.bounced, email.complained, email.delivery_delayed.
# Without it emails can reach "sent" (accepted) but never "delivered" (confirmed).
RESEND_WEBHOOK_SECRET=

# Public URL of the deployment (links in emails). On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as a fallback.
APP_URL=
