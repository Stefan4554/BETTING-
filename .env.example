# ─────────────────────────────────────────────────────────────────────────────
# EDGE INTELLIGENCE — environment variables
# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables.
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle at BUILD time
# (rebuild after changing them). Everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Data mode. "true" = synthetic, clearly-labelled demo data (no keys needed).
# "false" = live providers only; any provider without a key shows NOT CONNECTED.
NEXT_PUBLIC_DEMO_MODE=true

# ── Supabase (Postgres, Auth, Realtime) ── https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by ingestion workers. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Odds: The Odds API ── https://the-odds-api.com  (paid plan recommended)
THE_ODDS_API_KEY=
# Bookmaker regions (comma separated): uk, eu, us, us2, au. Each region multiplies credit cost.
THE_ODDS_API_REGIONS=eu,uk
# Markets: h2h (match winner), spreads (game handicap), totals (total games).
THE_ODDS_API_MARKETS=h2h,spreads,totals

# ── Tennis data: Sportradar Tennis v3 ── https://developer.sportradar.com
SPORTRADAR_TENNIS_API_KEY=
# "trial" or "production" — must match your key's access level.
SPORTRADAR_TENNIS_ACCESS_LEVEL=trial

# ── Tennis data (alternative): API-Tennis ── https://api-tennis.com
# Used only when no Sportradar key is set.
API_TENNIS_KEY=

# ── Odds (planned, phase 2): Sportradar Odds Comparison ──
SPORTRADAR_ODDS_API_KEY=

# ── Background jobs ──
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Optional: email alerts via Resend ── https://resend.com
RESEND_API_KEY=
ALERTS_FROM_EMAIL=
